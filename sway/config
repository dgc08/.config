# (Aldo Cortesi, dequis, Randall Ma, Tycho Andersen, Craig Barnes, horsik, Tao Sauvage)

### Variables
set $mod Mod4
set $terminal alacritty
set $locker swaylock

# "office" combo from the qtile config (mod+shift+ctrl+alt)
set $office $mod+Shift+Ctrl+Mod1

### Output / wallpaper
# qtile picked a random wallpaper from ~/.config/qtile/wallpapers/
# swaybg only takes one image per output, so pick one at start via a wrapper script,
# or just point directly at a file/dir here:
exec_always swaymsg output "*" bg $(find ~/.config/qtile/wallpapers/ -type f | shuf -n1) fill

### Autostart
# qtile's hook.subscribe.startup ran autostart_wayland.sh on wayland;
# since sway is always Wayland, we always call that one.
exec_always ~/.config/sway/autostart.sh
# qtile's hook.subscribe.startup_once ran autostart_post.sh once
exec ~/.config/qtile/autostart_post.sh

### Input
input type:keyboard {
      xkb_layout "de,ru"
}
# mod+ctrl+z toggled caps:swapescape — bound as a key below via swaymsg

### Basic behavior
focus_follows_mouse yes
mouse_warping none
focus_on_window_activation smart
default_border pixel 2
default_floating_border pixel 2

# border colors (approximating border_focus_stack from qtile Columns layout)
client.focused          #d75f5f #d75f5f #ffffff #d75f5f #d75f5f
client.focused_inactive #8f3d3d #8f3d3d #ffffff #8f3d3d #8f3d3d

### Bar
# qtile used a top bar.Bar with custom widgets; swap in waybar (or swaybar) instead.
bar {
    swaybar_command waybar
}

### Key bindings

# Focus movement (mod+hjkl)
bindsym $mod+h focus left
bindsym $mod+l focus right
bindsym $mod+j focus down
bindsym $mod+k focus up
bindsym $mod+space focus next

# Move windows (mod+shift+hjkl)
bindsym $mod+Shift+h move left
bindsym $mod+Shift+l move right
bindsym $mod+Shift+j move down
bindsym $mod+Shift+k move up

# Grow/resize windows (mod+ctrl+hjkl)
bindsym $mod+Ctrl+h resize grow left 30px
bindsym $mod+Ctrl+l resize grow right 30px
bindsym $mod+Ctrl+j resize grow down 30px
bindsym $mod+Ctrl+k resize grow up 30px

# Reset window sizes / normalize — closest sway equivalent is re-splitting
#bindsym $mod+n layout toggle split

# Toggle split/unsplit stack view
bindsym $mod+Shift+Return layout toggle split

# Launch terminal
bindsym $mod+Return exec $terminal

# Rofi application launcher
bindsym $mod+BackSpace exec ~/.config/qtile/rofi.sh

# Screenshot
bindsym Print exec flameshot gui

# Layout switch script (the "office" key combo)
bindsym $office+space exec ~/.config/qtile/layout.sh

# Cycle layouts
#bindsym $mod+Tab layout toggle split
bindsym $mod+Tab layout toggle split tabbed

# Kill focused window
bindsym $mod+w kill

# Keyboard layout toggles
bindsym $mod+z exec setxkbmap -option
bindsym $mod+Ctrl+z exec setxkbmap -option caps:swapescape
# Native wayland equivalent (uncomment if setxkbmap doesn't apply under sway):
# bindsym $mod+Ctrl+z input "type:keyboard" xkb_options caps:swapescape

# Apps
bindsym $mod+q exec emacsclient -c
bindsym $mod+e exec thunar

# Window state toggles
bindsym $mod+f fullscreen toggle
bindsym $mod+t floating toggle
bindsym $mod+b exec swaymsg bar mode toggle

# Reload config
bindsym $mod+Ctrl+r reload
bindsym $mod+Shift+c reload

# Lock screen / logout
bindsym $mod+p exec $locker
bindsym $mod+Ctrl+p exec swaynag -t warning -m 'Exit sway?' -b 'Yes' 'swaymsg exit'

# Media keys (custom, mod-based)
bindsym $mod+y exec playerctl previous
bindsym $mod+Ctrl+y exec pactl set-sink-volume @DEFAULT_SINK@ -1%
bindsym $mod+x exec playerctl play-pause
bindsym $mod+c exec playerctl next
bindsym $mod+Ctrl+c exec pactl set-sink-volume @DEFAULT_SINK@ +1%

# Mic mute toggle
bindsym $mod+g exec pactl set-source-mute @DEFAULT_SOURCE@ toggle

# Standard media keys (XF86)
bindsym XF86AudioPrev exec playerctl previous
bindsym XF86AudioLowerVolume exec pactl set-sink-volume @DEFAULT_SINK@ -1%
bindsym XF86AudioPlay exec playerctl play-pause
bindsym XF86AudioNext exec playerctl next
bindsym XF86AudioRaiseVolume exec pactl set-sink-volume @DEFAULT_SINK@ +1%
bindsym XF86Tools exec pavucontrol
bindsym XF86Calculator exec speedcrunch

# Misc utilities
bindsym $mod+r exec flatpak run it.mijorus.smile
bindsym $mod+v exec rofi -modi "clipboard:greenclip print" -show clipboard -run-command '{cmd}'

### Workspaces (qtile groups "123asduiom")
set $ws1 "1:1"
set $ws2 "2:2"
set $ws3 "3:3"
set $wsa "3:a"
set $wss "4:s"
set $wsd "5:d"
set $wsu "6:u"
set $wsi "7:i"
set $wso "8:o"
set $wsm "9:m"

bindsym $mod+1 workspace $ws1
bindsym $mod+2 workspace $ws2
bindsym $mod+3 workspace $ws3
bindsym $mod+a workspace $wsa
bindsym $mod+s workspace $wss
bindsym $mod+d workspace $wsd
bindsym $mod+u workspace $wsu
bindsym $mod+i workspace $wsi
bindsym $mod+o workspace $wso
bindsym $mod+m workspace $wsm

bindsym $mod+Shift+1 move container to workspace $ws1
bindsym $mod+Shift+2 move container to workspace $ws2
bindsym $mod+Shift+3 move container to workspace $ws3
bindsym $mod+Shift+a move container to workspace $wsa
bindsym $mod+Shift+s move container to workspace $wss
bindsym $mod+Shift+d move container to workspace $wsd
bindsym $mod+Shift+u move container to workspace $wsu
bindsym $mod+Shift+i move container to workspace $wsi
bindsym $mod+Shift+o move container to workspace $wso
bindsym $mod+Shift+m move container to workspace $wsm

# VT switching (control+mod1+f1..f8) — sway/wayland handles this at the session level natively,
# no binding needed (unlike qtile's manual .when(func=...) workaround).

### Floating rules (from qtile's float_rules)
for_window [title="emacs-everywhere"] floating enable
for_window [title="Smile"] floating enable
for_window [app_id="confirmreset"] floating enable
for_window [app_id="makebranch"] floating enable
for_window [app_id="maketag"] floating enable
for_window [app_id="ssh-askpass"] floating enable
for_window [title="branchdialog"] floating enable
for_window [title="pinentry"] floating enable

# qtile's floats_kept_above = True
for_window [floating] border pixel 2

# default_border none
# for_window [title="^.*"] title_format ""
# default_border normal 0
# default_floating_border normal 0

# hide_edge_borders --i3 smart

default_border normal 0
default_floating_border normal 0
for_window [class=".*"] border pixel 2
for_window [app_id=".*"] border pixel 2

font pango:monospace 0.01
titlebar_border_thickness 0
titlebar_padding 0
smart_borders on
#hide_edge_borders --i3 smart

### Drag/resize floating windows with mouse (qtile's mouse = [Drag(...), Click(...)])
floating_modifier $mod normal
# left click+drag = move (default), right click+drag = resize (default in sway)
# middle click to bring to front is automatic on focus in sway
